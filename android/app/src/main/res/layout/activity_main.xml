<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutAnimation="@anim/layout_fade_in"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_shield" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Health Sync"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Health Connect to Google Drive"
                android:textColor="@color/muted_ink"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:text="Aggregate totals"
                    android:textColor="@color/teal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="Raw records"
                    android:textColor="@color/teal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Connect Health Connect"
            app:backgroundTint="@color/teal"
            app:icon="@drawable/ic_health"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Connect Google Drive File"
            app:backgroundTint="@color/drive_blue"
            app:icon="@drawable/ic_drive"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sync Now"
            app:backgroundTint="@color/sync_green"
            app:icon="@drawable/ic_sync"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Start Auto Sync"
            app:backgroundTint="@color/teal_dark"
            app:icon="@drawable/ic_clock"
            app:iconTint="@android:color/white" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_status_panel"
            android:elevation="1dp"
            android:lineSpacingMultiplier="1.25"
            android:minHeight="118dp"
            android:padding="18dp"
            android:text="Checking status..."
            android:textColor="@color/muted_ink"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
